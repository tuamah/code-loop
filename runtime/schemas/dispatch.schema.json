{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Dispatch Intent",
  "description": "A recorded intent to hand work to an AgentRuntime. This is not an execution record: status is intentionally limited to non-executing values until the runtime has complete policy gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "created_at", "actor_id", "role", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "actor_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "provider": { "type": "string" },
    "runtime": { "type": "string" },
    "model": { "type": "string" },
    "plan_id": { "type": "string", "minLength": 1 },
    "route_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["intended", "cancelled", "superseded"] },
    "reason": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
