{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Methodology Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["methodology_id", "version", "macro_phases", "subphases", "loops", "principles"],
  "properties": {
    "methodology_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "macro_phases": {
      "type": "array",
      "items": { "enum": ["DEFINE", "RESEARCH", "DESIGN", "PREPARE", "BUILD", "VERIFY", "RELEASE", "OPERATE", "EVOLVE"] },
      "uniqueItems": true
    },
    "subphases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" },
      "uniqueItems": true
    },
    "loops": {
      "type": "array",
      "items": { "enum": ["research_loop", "build_loop", "verify_loop", "repair_loop", "improvement_loop"] },
      "uniqueItems": true
    },
    "principles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^GP-([1-9]|1[0-9]|20)$" },
      "uniqueItems": true
    }
  }
}
