{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Process Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "skippable_phases"],
  "properties": {
    "id": { "enum": ["LIGHT", "STANDARD", "STRICT"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "skippable_phases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" },
      "uniqueItems": true
    }
  }
}
