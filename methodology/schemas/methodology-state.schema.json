{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Project Methodology State",
  "description": "Per-project state written by scripts/nogap_methodology.py (M7-B): ProjectIntent, RiskLevel, ClaimStrength, and a disclosed, deterministic profile derivation. current_phase is always \"P0\" in this milestone - there is no transition engine behind it yet (M7-C).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodology_id", "methodology_version", "intent", "risk", "claim_strength",
    "derived_profile", "derivation", "effective_profile", "phase_profile_overrides",
    "downgrade_log", "current_phase", "created_by", "created_at", "updated_at"
  ],
  "properties": {
    "methodology_id": { "type": "string", "minLength": 1 },
    "methodology_version": { "type": "string", "minLength": 1 },
    "intent": { "enum": ["research", "production", "experimental"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "claim_strength": { "enum": ["low", "medium", "high"] },
    "derived_profile": {
      "enum": ["LIGHT", "STANDARD", "STRICT"],
      "description": "Deterministically derived from intent/risk/claim_strength. Never hand-edited."
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "risk", "claim_strength", "risk_score", "claim_score", "intent_floor", "raw_score", "profile", "reason"],
      "properties": {
        "intent": { "enum": ["research", "production", "experimental"] },
        "risk": { "enum": ["low", "medium", "high"] },
        "claim_strength": { "enum": ["low", "medium", "high"] },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 2 },
        "claim_score": { "type": "integer", "minimum": 0, "maximum": 2 },
        "intent_floor": { "type": "integer", "minimum": 0, "maximum": 2 },
        "raw_score": { "type": "integer", "minimum": 0, "maximum": 2 },
        "profile": { "enum": ["LIGHT", "STANDARD", "STRICT"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "effective_profile": {
      "enum": ["LIGHT", "STANDARD", "STRICT"],
      "description": "What is actually active: equals derived_profile unless an authorized downgrade is recorded in downgrade_log."
    },
    "phase_profile_overrides": {
      "type": "object",
      "description": "Escalation only (value must be >= effective_profile); keys are macro phase names or P-ids.",
      "additionalProperties": { "enum": ["LIGHT", "STANDARD", "STRICT"] }
    },
    "downgrade_log": {
      "type": "array",
      "description": "Append-only audit trail. The only way effective_profile can ever be lowered.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_profile", "to_profile", "actor_id", "reason", "authorized_at"],
        "properties": {
          "from_profile": { "enum": ["LIGHT", "STANDARD", "STRICT"] },
          "to_profile": { "enum": ["LIGHT", "STANDARD", "STRICT"] },
          "actor_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "authorized_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "current_phase": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
