{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Methodology Phase Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "macro_phase", "name", "required_inputs", "required_artifacts", "required_evidence", "required_roles", "exit_gate", "allowed_next", "allowed_back_transitions", "failure_transition", "minimum_profile"],
  "properties": {
    "id": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" },
    "macro_phase": { "enum": ["DEFINE", "RESEARCH", "DESIGN", "PREPARE", "BUILD", "VERIFY", "RELEASE", "OPERATE", "EVOLVE"] },
    "name": { "type": "string", "minLength": 1 },
    "loop": { "enum": ["research_loop", "build_loop", "verify_loop", "repair_loop", "improvement_loop"] },
    "required_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "exit_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "checks"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "allowed_next": {
      "type": "array",
      "items": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" }
    },
    "allowed_back_transitions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^P([0-9]|1[0-9]|2[0-3])$" }
    },
    "failure_transition": {
      "type": ["string", "null"],
      "pattern": "^(P([0-9]|1[0-9]|2[0-3])|REPAIR_LOOP)$"
    },
    "minimum_profile": { "enum": ["LIGHT", "STANDARD", "STRICT"] }
  }
}
