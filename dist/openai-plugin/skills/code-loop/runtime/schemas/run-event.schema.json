{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Run Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "type", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "TASK_CREATED",
        "GATE_FROZEN",
        "PLAN_ACCEPTED",
        "AGENT_DISPATCHED",
        "TOOL_CALLED",
        "PATCH_CREATED",
        "VERIFY_STARTED",
        "VERIFY_FAILED",
        "VERIFY_PASSED",
        "REPAIR_REQUESTED",
        "CLAIM_SUPPORTED",
        "CLAIM_CONTRADICTED",
        "DECISION_ACCEPTED",
        "DECISION_REPAIR",
        "DECISION_ABSTAIN",
        "HUMAN_REVIEW_REQUESTED"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "string" },
    "payload": { "type": "object" }
  }
}
