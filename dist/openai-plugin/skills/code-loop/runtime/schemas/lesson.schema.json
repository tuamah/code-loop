{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "text", "applies_when", "evidence", "source_decision"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "applies_when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags"],
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "decision": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_decision": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
