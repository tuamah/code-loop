{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoGapCode Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "kind", "status", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["test", "lint", "typecheck", "build", "trace", "benchmark", "screenshot", "review", "source-reference"]
    },
    "status": { "enum": ["passed", "failed", "blocked", "inconclusive"] },
    "claim_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_at"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "commit": { "type": "string" },
        "gate_hash": { "type": "string" },
        "command": { "type": "string" },
        "artifact_path": { "type": "string" }
      }
    },
    "summary": { "type": "string" }
  }
}
